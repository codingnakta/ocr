# ---------------------------------------------------------------------------
# 필기봇 OCR Studio configuration. Copy to `.env` (never commit `.env`).
# All of this is read by the BACKEND only. Nothing here is sent to the browser.
# ---------------------------------------------------------------------------

# --- Claude API (required for AI / hybrid OCR) ------------------------------
# Create a key at https://platform.claude.com (Console > API keys). API usage is
# billed to that organization's API credits — separate from Claude Pro/Max plans.
ANTHROPIC_API_KEY=
# Model used for OCR (see https://platform.claude.com/docs/en/about-claude/models)
OCR_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (thinking depth vs cost; Opus 5.5 default: medium)
OCR_CLAUDE_EFFORT=medium
# Server-side refusal fallback ("default" routing). Empty = off.
OCR_CLAUDE_FALLBACKS=default
# Optional pricing override when prices change (USD / 1M tokens):
# model=input,output,cache_read,cache_write_5m ; separate models with ';'
# OCR_CLAUDE_PRICING_OVERRIDE=claude-opus-5-5=4,20,0.2,5

# --- Environment & login ----------------------------------------------------
# development: no login (only for your own computer, published on 127.0.0.1)
# production : login required; the app refuses to start with AUTH_MODE=none
APP_ENV=development
AUTH_MODE=none
# For AUTH_MODE=password:
# SESSION_SECRET=<random 32+ chars, e.g. `openssl rand -hex 32`>
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<strong password>
# COOKIE_SECURE=true          # when served over HTTPS
SESSION_MAX_AGE_HOURS=168

# --- Cost limits -------------------------------------------------------------
DEFAULT_JOB_COST_LIMIT_USD=5
DAILY_COST_LIMIT_USD=30

# --- Upload limits -----------------------------------------------------------
MAX_FILE_MB=40
MAX_PAGES_PER_DOCUMENT=500
MAX_PDF_PAGES_PER_FILE=300

# --- Storage -----------------------------------------------------------------
# local (default) or s3 (any S3-compatible object storage)
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Delete documents N days after last change (0 = keep; production default 14)
RETENTION_DAYS=0

# --- Database ------------------------------------------------------------------
# docker compose sets DATABASE_URL to its PostgreSQL service automatically.
# Without Docker the default is SQLite in backend/data/.
POSTGRES_PASSWORD=pilgibot-local-only
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/pilgibot

# --- Worker ----------------------------------------------------------------------
WORKER_CONCURRENCY=2

# --- docker compose publishing ----------------------------------------------------
# PUBLISH_ADDR=127.0.0.1   # 0.0.0.0 to open to your network (enable login first!)
# PORT=3000
